{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "splash",
  "version": "0.1.0",
  "identifier": "com.madan.splash",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
      "windows": [
        {
          "label": "main",
          "width": 1920,
          "height": 140,
          "x": 0,
          "y": 0,
          "decorations": false,
          "transparent": true,
          "resizable": false,
          "maximizable": false,
          "minimizable": false,
          "closable": false,
          "alwaysOnTop": true,
          "visibleOnAllWorkspaces": true,
          "focus": false,
          "skipTaskbar": true,
          "shadow": false,
          "visible": true
        }
      ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
